DATABASE_URL="postgres://user:password@localhost:5432/database_name"
# Таймаут установки соединения с БД, мс. 0 — без таймаута
DATABASE_CONNECT_TIMEOUT_MS=5000

# development | production | test — влияет на формат и уровень лога
NODE_ENV="development"
# trace | debug | info | warn | error | fatal | silent
# По умолчанию: info в production, warn в тестах, debug в остальных случаях
LOG_LEVEL="debug"

PORT=3000

# Базовый путь приложения за reverse proxy, напр. /app/my-app (без слеша на конце).
# Пусто — без префикса
BASE_PATH=""
